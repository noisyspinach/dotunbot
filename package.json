{
    "name": "dotunbot",
    "version": "2.0.0",
    "description": "A very cool Discord bot",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=20.6"
    },
    "scripts": {
        "dev": "tsx watch --env-file=.env src/index.ts",
        "build": "tsc",
        "start": "node --env-file=.env dist/index.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@sapphire/framework": "^5.3.0",
        "discord.js": "^14.16.0"
    },
    "devDependencies": {
        "@types/node": "^22.7.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0"
    }
}
